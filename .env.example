# ==============================================================================
# QuickCart - Environment Configuration Blueprint
# ==============================================================================
# Copy this file to .env before starting the development environment:
#   cp .env.example .env
#
# IMPORTANT: Never commit actual .env files containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. PostgreSQL & Prisma Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=quickcart_user
POSTGRES_PASSWORD=quickcart_secret_password
POSTGRES_DB=quickcart_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Connection string used by Prisma ORM
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://quickcart_user:quickcart_secret_password@localhost:5432/quickcart_db?schema=public

# ------------------------------------------------------------------------------
# 3. Redis Cache & Job Queue Configuration
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Cache TTL Configuration (in seconds)
CACHE_TTL_PRODUCTS=300
CACHE_TTL_CATEGORIES=3600
CACHE_TTL_CART=86400

# ------------------------------------------------------------------------------
# 4. JWT & Authentication Secrets
# ------------------------------------------------------------------------------
# Cryptographically secure random strings (min 32 characters in production)
JWT_ACCESS_SECRET=quickcart_dev_jwt_access_secret_super_secure_key_12345
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=quickcart_dev_jwt_refresh_secret_super_secure_key_67890
JWT_REFRESH_EXPIRES_IN=7d

# Password Hashing
BCRYPT_SALT_ROUNDS=12

# ------------------------------------------------------------------------------
# 5. Rate Limiting Configuration
# ------------------------------------------------------------------------------
# General API Rate Limit (e.g. 100 requests per 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Strict Auth Rate Limit (e.g. 10 requests per 15 minutes)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# ------------------------------------------------------------------------------
# 6. E-Commerce Business Logic Configuration
# ------------------------------------------------------------------------------
# Order expiration time: time before an unpaid order is cancelled and inventory released
ORDER_EXPIRATION_MINUTES=15

# Pagination Defaults
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=50

# ------------------------------------------------------------------------------
# 7. Simulated Payment Gateway Configuration
# ------------------------------------------------------------------------------
# Simulated failure rate (0 to 1, e.g., 0.1 = 10% failure rate for failure simulation testing)
SIMULATED_PAYMENT_FAILURE_RATE=0.0
SIMULATED_PAYMENT_LATENCY_MS=300
