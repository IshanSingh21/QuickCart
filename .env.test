# ==============================================================================
# QuickCart - Automated Testing Environment Configuration
# ==============================================================================
NODE_ENV=test
PORT=5001
API_PREFIX=/api/v1
CORS_ORIGIN=*

DATABASE_URL=postgresql://quickcart_user:quickcart_secret_password@localhost:5432/quickcart_test_db?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

CACHE_TTL_PRODUCTS=60
CACHE_TTL_CATEGORIES=60
CACHE_TTL_CART=60

JWT_ACCESS_SECRET=quickcart_test_jwt_access_secret_super_secure_key_12345
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=quickcart_test_jwt_refresh_secret_super_secure_key_67890
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=4

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

LOG_LEVEL=silent
