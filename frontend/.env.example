# ==============================================================================
# QuickCart Frontend Environment Configuration
# ==============================================================================
# Copy this file to .env for local development, or configure these variables
# in your hosting dashboard (e.g., Vercel, Netlify, Cloudflare Pages, Docker).
# ==============================================================================

# Backend API Base URL (Must include the verified /api/v1 version prefix)
# Development (Localhost Express Backend):
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Staging Environment:
# VITE_API_BASE_URL=https://staging-api.quickcart.com/api/v1

# Production Environment:
# VITE_API_BASE_URL=https://api.quickcart.com/api/v1

# Application Environment Mode ('development' | 'test' | 'production')
VITE_APP_ENV=development
